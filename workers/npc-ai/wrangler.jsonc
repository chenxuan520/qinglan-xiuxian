{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qinglan-npc-ai",
  "main": "index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": true,
  "routes": [{ "pattern": "qinglan-npc-ai.011203.xyz", "custom_domain": true }],
  "ai": { "binding": "AI" },
  "ratelimits": [
    {
      "name": "NPC_LIMITER",
      "namespace_id": "202609201",
      "simple": { "limit": 12, "period": 60 },
    },
    {
      "name": "IMAGE_LIMITER",
      "namespace_id": "202609232",
      "simple": { "limit": 2, "period": 60 },
    },
    {
      "name": "EVENT_LIMITER",
      "namespace_id": "202610011",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "MONITOR_LIMITER",
      "namespace_id": "202610101",
      "simple": { "limit": 12, "period": 60 },
    },
  ],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "qinglan_events" }],
  "vars": {
    "ALLOWED_ORIGINS": "https://xiuxian.011203.xyz,https://chenxuan520.github.io",
    "MONITOR_PUBLIC": "true",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
