{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "qinglan-house-ads",
  "main": "index.ts",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ratelimits": [
    {
      "name": "AD_DIAGNOSTIC_LIMITER",
      "namespace_id": "1825766704",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      "name": "AD_RECEIPT_LIMITER",
      "namespace_id": "1825766703",
      "simple": { "limit": 60, "period": 60 },
    },
  ],
  "routes": [
    { "pattern": "xiuxian.011203.xyz/api/client-status", "zone_name": "011203.xyz" },
    { "pattern": "xiuxian.011203.xyz/ads/*", "zone_name": "011203.xyz" },
    { "pattern": "xiuxian.011203.xyz/ads.txt", "zone_name": "011203.xyz" },
    { "pattern": "qinglan-ads.011203.xyz", "custom_domain": true },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qinglan-house-ads",
      "database_id": "d18d2613-8f1f-45d8-ac1c-f4ed87e40f14",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ADMIN_ORIGIN": "https://xiuxian.011203.xyz",
    "ALLOWED_ORIGINS": "https://xiuxian.011203.xyz,https://chenxuan520.github.io",
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
}
